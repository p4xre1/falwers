# Cloudflare Pages headers — Rose by Marry (hardened)
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: index, follow, max-image-preview:large
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/cart
  X-Robots-Tag: noindex

/checkout
  X-Robots-Tag: noindex

/wishlist
  X-Robots-Tag: noindex

/track
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

# AI discovery layer — must be publicly readable and correctly typed.
# Cloudflare would otherwise serve .txt as octet-stream to some agents, and the
# default same-origin CORP blocks assistants fetching these cross-origin.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  X-Robots-Tag: index, follow

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  X-Robots-Tag: index, follow

/ai.txt
  Content-Type: text/plain; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/ai-sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/.well-known/*
  Content-Type: application/json; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/mcp.json
  Content-Type: application/json; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/ai-plugin.json
  Content-Type: application/json; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/openapi.json
  Content-Type: application/json; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000, immutable

/og-image.jpg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800
